# ─────────────────────────────────────────────────────────────────────────
# SI-APARAT API — Environment Variables Template
# Salin file ini ke .env dan isi semua nilai sebelum menjalankan aplikasi
# ─────────────────────────────────────────────────────────────────────────

# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────
# Dapatkan dari: https://neon.tech → Project → Connection Details
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/si_aparat?sslmode=require"

# ─── Encryption ───────────────────────────────────────────────────────────
# WAJIB: 64-char hex string (32 bytes = 256 bit)
# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Simpan key ini di Infisical. Jika hilang, semua data laporan tidak bisa didekripsi!
ENCRYPTION_KEY="GANTI_DENGAN_64_KARAKTER_HEX_STRING_HASIL_GENERATE"

# ─── JWT ──────────────────────────────────────────────────────────────────
# Generate dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="GANTI_DENGAN_JWT_SECRET_YANG_KUAT"

# ─── Cloudflare R2 Object Storage ────────────────────────────────────────
# Dapatkan dari: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="si-aparat-lampiran"

# ─── Resend Email ─────────────────────────────────────────────────────────
# Dapatkan dari: https://resend.com → API Keys
RESEND_API_KEY="re_xxxxxxxxxxxx"
# Alamat pengirim (harus sudah diverifikasi di Resend)
EMAIL_FROM="SI-APARAT <noreply@aparat.sch.id>"

# ─── Admin Seeder ─────────────────────────────────────────────────────────
# Email untuk akun SUPER_ADMIN awal (dibuat saat pnpm db:seed)
ADMIN_EMAIL="admin@sekolah.sch.id"

# ─── Server ───────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ─── Frontend (CORS) ──────────────────────────────────────────────────────
# URL frontend yang diizinkan mengakses API
FRONTEND_URL="http://localhost:5173"
# Production: FRONTEND_URL="https://aparat.namasekolah.sch.id"
